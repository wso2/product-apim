{
  "name": "${UNIQUE:ExternalIdp1Km}",
  "displayName": "External IdP 1 (self-validated JWT)",
  "type": "WSO2-IS-7",
  "description": "Self-validating external IdP key manager: the gateway verifies signatures against the PEM certificate installed after create (certs/externalidp1) and resolves the application by the mapped azp claim. Its management endpoints are never contacted.",
  "issuer": "https://external-idp-1.apim.integration",
  "alias": "external-idp-1-audience",
  "tokenEndpoint": "https://external-idp-1.apim.integration/oauth2/token",
  "introspectionEndpoint": "https://external-idp-1.apim.integration/oauth2/introspect",
  "revokeEndpoint": "https://external-idp-1.apim.integration/oauth2/revoke",
  "authorizeEndpoint": "https://external-idp-1.apim.integration/oauth2/authorize",
  "userInfoEndpoint": "https://external-idp-1.apim.integration/scim2/Me",
  "scopeManagementEndpoint": "https://external-idp-1.apim.integration/api/identity/oauth2/v1.0/scopes",
  "clientRegistrationEndpoint": "https://external-idp-1.apim.integration/api/identity/oauth2/dcr/v1.1/register",
  "consumerKeyClaim": "azp",
  "scopesClaim": "scope",
  "enabled": true,
  "enableTokenGeneration": false,
  "enableOAuthAppCreation": false,
  "enableMapOAuthConsumerApps": true,
  "enableProvisionedAppValidation": false,
  "enableSelfValidationJWT": true,
  "availableGrantTypes": [
    "client_credentials",
    "password",
    "refresh_token",
    "urn:ietf:params:oauth:grant-type:token-exchange"
  ],
  "claimMapping": [
    {
      "remoteClaim": "http://idp.org/claims/givenname",
      "localClaim": "http://wso2.org/claims/givenname"
    },
    {
      "remoteClaim": "http://idp.org/claims/firstname",
      "localClaim": "http://wso2.org/claims/firstname"
    },
    {
      "remoteClaim": "http://idp.org/claims/email",
      "localClaim": "http://wso2.org/claims/email"
    }
  ],
  "tokenType": "BOTH",
  "additionalProperties": {
    "Authentication": "BasicAuth",
    "api_resource_management_endpoint": "https://external-idp-1.apim.integration/api/server/v1/api-resources",
    "is7_roles_endpoint": "https://external-idp-1.apim.integration/scim2/v2/Roles",
    "Username": "admin",
    "Password": "admin",
    "self_validate_jwt": true,
    "enable_roles_creation": false
  }
}
