        "actionDuration": "30000",
        "actionSelect": "fault",
        "factor": "1",
        "retryDelay": "0",
        "retryErroCode": [],
        "suspendDuration": "0",
        "suspendMaxDuration": "0"
      },
      "template_not_supported": false
    }
