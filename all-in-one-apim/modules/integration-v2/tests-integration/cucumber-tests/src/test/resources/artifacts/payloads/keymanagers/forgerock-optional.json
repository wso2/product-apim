{
  "name": "${UNIQUE:ForgerockKMOpt}",
  "displayName": "Test Key Manager Forgerock",
  "type": "Forgerock",
  "description": "This is a test key manager",
  "issuer": "http://localhost:8080/openam/oauth2",
  "introspectionEndpoint": "http://localhost:8080/openam/oauth2/introspect",
  "clientRegistrationEndpoint": "http://localhost:8080/openam/oauth2/register",
  "tokenEndpoint": "http://localhost:8080/openam/oauth2/access_token",
  "revokeEndpoint": "http://localhost:8080/openam/oauth2/revoke",
  "userInfoEndpoint": "http://localhost:8080/openam/oauth2/userinfo",
  "authorizeEndpoint": "http://localhost:8080/openam/oauth2/authorize",
  "scopeManagementEndpoint": "http://localhost:8080/openam/oauth2/scopes",
  "consumerKeyClaim": "aud",
  "scopesClaim": "scp",
  "enabled": true,
  "enableTokenGeneration": true,
  "enableMapOAuthConsumerApps": true,
  "enableOAuthAppCreation": true,
  "availableGrantTypes": [
    "client_credentials",
    "password",
    "implicit",
    "refresh_token",
    "authorization_code"
  ],
  "certificates": {
    "type": "JWKS",
    "value": "http://localhost:8080/openam/oauth2/connect/jwk_url"
  },
  "additionalProperties": {
    "client_id": "clientIdValue",
    "client_secret": "clientSecretValue",
    "self_validate_jwt": true
  }
}
