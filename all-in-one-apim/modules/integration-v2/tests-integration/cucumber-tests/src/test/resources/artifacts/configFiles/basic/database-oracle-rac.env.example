# Copy this file to a private path and provide credentials for an Oracle RAC service.
# Select the profile with:
# -Dapim.test.db.profile=oracle-rac -Dapim.test.db.envFile=/path/to/database.env
#
# Use the RAC SCAN host and service name, for example:
# jdbc:oracle:thin:@//rac-scan.example.net:1521/apim.example.net
# The endpoint must be reachable both from the test runner and from APIM test containers.
database.type=oracle
database.driver=oracle.jdbc.driver.OracleDriver
database.provision.url=jdbc:oracle:thin:@//rac-scan.example.net:1521/apim.example.net
database.provision.urlTemplate=jdbc:oracle:thin:@//rac-scan.example.net:1521/apim.example.net
database.provision.username=APIM_PROVISION_USER
database.provision.password=replace-with-secret
database.jdbc.urlTemplate=jdbc:oracle:thin:@//rac-scan.example.net:1521/apim.example.net
database.runtime.password=replace-with-generated-secret
database.validationQuery=SELECT 1 FROM DUAL
