# Copy to a private file and pass it with:
# -Dapim.test.db.profile=db2 -Dapim.test.db.envFile=/path/to/database.env
#
# Db2 database creation and deletion use the Db2 CLP inside the configured Docker container.
# The DB2 instance owner is also used by APIM because Db2 LUW users are operating-system users.
database.type=db2
database.driver=com.ibm.db2.jcc.DB2Driver
database.provision.url=jdbc:db2://127.0.0.1:50000/APIMBOOT
database.provision.urlTemplate=jdbc:db2://127.0.0.1:50000/{database}
database.provision.username=db2inst1
database.provision.password=replace-with-instance-password
database.provision.container=apim-hosted-db
database.jdbc.urlTemplate=jdbc:db2://host.docker.internal:50000/{database}
database.runtime.username=db2inst1
database.runtime.password=replace-with-instance-password
database.validationQuery=SELECT 1 FROM SYSIBM.SYSDUMMY1
