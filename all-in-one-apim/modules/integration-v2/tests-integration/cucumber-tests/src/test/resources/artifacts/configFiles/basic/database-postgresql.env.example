# Copy this file to a private env file and provide credentials through CI secrets.
# APIM's PostgreSQL database type is `postgre` (as documented in deployment.toml).
# The provisioning account must be able to CREATE/DROP databases and grant database/schema privileges to the
# runtime account. The runtime account needs login access to the server.

database.type=postgre
database.driver=org.postgresql.Driver

# The test JVM uses these URLs to provision/drop block databases and execute the product schema scripts.
database.provision.url=jdbc:postgresql://127.0.0.1:5432/postgres
database.provision.urlTemplate=jdbc:postgresql://127.0.0.1:5432/{database}
database.provision.username=REPLACE_WITH_PROVISIONING_USER
database.provision.password=REPLACE_WITH_PROVISIONING_PASSWORD

# APIM containers use this URL template; replace the host/port with an endpoint reachable from Docker.
database.jdbc.urlTemplate=jdbc:postgresql://host.docker.internal:5432/{database}
database.runtime.username=REPLACE_WITH_RUNTIME_USER
database.runtime.password=REPLACE_WITH_RUNTIME_PASSWORD
database.validationQuery=SELECT 1
