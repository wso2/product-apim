<sequence xmlns="http://ws.apache.org/ns/synapse" name="script_mediator_json_response">
    <script language="js"><![CDATA[
        mc.setProperty('CONTENT_TYPE', 'application/json');
        var response = new Object();
        response.name = "testName";
        response.checkNull = null;
        mc.setPayloadJSON(response);
    ]]></script>
    <filter source="boolean(get-property('CONTENT_TYPE'))" regex="false">
        <then>
            <property name="messageType" value="application/xml" scope="axis2"/>
        </then>
        <else>
            <property name="messageType" expression="get-property('CONTENT_TYPE')" scope="axis2"/>
        </else>
    </filter>
    <property name="NO_ENTITY_BODY" scope="axis2" action="remove"/>
</sequence>
