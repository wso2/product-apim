{
  "name": "${UNIQUE:ScopeMatrixAPI}",
  "context": "${UNIQUE:scopeMatrixContext}",
  "version": "1.0.0",
  "endpointConfig": {
    "endpoint_type": "http",
    "production_endpoints": {
      "template_not_supported": false,
      "config": null,
      "url": "http://nodebackend:3001/jaxrs_basic/services/customers/customerservice/"
    },
    "sandbox_endpoints": {
      "url": "http://nodebackend:3001/jaxrs_basic/services/customers/customerservice/",
      "config": null,
      "template_not_supported": false
    }
  },
  "description": "Per-resource scope binding with wildcard precedence — the five ScopeA-E resources of AllowedScopesTestCase's ExampleAPI (ScopeA/B/D exact, ScopeC segment-wildcard, ScopeE global-wildcard). Every resource routes to the node backend /echo/* which 200s for any subpath, so ONLY the gateway's per-resource scope check distinguishes 200 from 403 across the full 5x5 token-by-path matrix.",
  "policies": [
    "Unlimited"
  ],
  "scopes": [
    {
      "scope": {
        "name": "ScopeA",
        "displayName": "ScopeA",
        "description": "exact-path scope (/echo/products/catalog/{categoryId})",
        "bindings": [
          "admin"
        ]
      },
      "shared": false
    },
    {
      "scope": {
        "name": "ScopeB",
        "displayName": "ScopeB",
        "description": "exact-path scope (/echo/products/popular)",
        "bindings": [
          "admin"
        ]
      },
      "shared": false
    },
    {
      "scope": {
        "name": "ScopeC",
        "displayName": "ScopeC",
        "description": "segment-wildcard scope (/echo/products/*)",
        "bindings": [
          "admin"
        ]
      },
      "shared": false
    },
    {
      "scope": {
        "name": "ScopeD",
        "displayName": "ScopeD",
        "description": "exact-path scope (/echo/orders)",
        "bindings": [
          "admin"
        ]
      },
      "shared": false
    },
    {
      "scope": {
        "name": "ScopeE",
        "displayName": "ScopeE",
        "description": "global-wildcard scope (/echo/*)",
        "bindings": [
          "admin"
        ]
      },
      "shared": false
    }
  ],
  "operations": [
    {
      "verb": "GET",
      "target": "/echo/products/catalog/{categoryId}",
      "authType": "Application & Application User",
      "throttlingPolicy": "Unlimited",
      "scopes": [
        "ScopeA"
      ]
    },
    {
      "verb": "GET",
      "target": "/echo/products/popular",
      "authType": "Application & Application User",
      "throttlingPolicy": "Unlimited",
      "scopes": [
        "ScopeB"
      ]
    },
    {
      "verb": "GET",
      "target": "/echo/products/*",
      "authType": "Application & Application User",
      "throttlingPolicy": "Unlimited",
      "scopes": [
        "ScopeC"
      ]
    },
    {
      "verb": "GET",
      "target": "/echo/orders",
      "authType": "Application & Application User",
      "throttlingPolicy": "Unlimited",
      "scopes": [
        "ScopeD"
      ]
    },
    {
      "verb": "GET",
      "target": "/echo/*",
      "authType": "Application & Application User",
      "throttlingPolicy": "Unlimited",
      "scopes": [
        "ScopeE"
      ]
    }
  ],
  "isDefaultVersion": true,
  "additionalProperties": [],
  "additionalPropertiesMap": {}
}
