# Copy this file to a private path and supply it with
# -Dapim.test.db.profile=oracle_23c -Dapim.test.db.envFile=/path/to/database.env
# The profile creates two unique Oracle schemas per all-in-one block inside the configured service.
database.type=oracle
database.driver=oracle.jdbc.driver.OracleDriver
database.provision.url=jdbc:oracle:thin:@//127.0.0.1:1521/FREEPDB1
database.provision.urlTemplate=jdbc:oracle:thin:@//127.0.0.1:1521/FREEPDB1
database.provision.username=system
database.provision.password=REPLACE_WITH_PROVISIONING_PASSWORD
database.jdbc.urlTemplate=jdbc:oracle:thin:@//host.docker.internal:1521/FREEPDB1
database.runtime.password=REPLACE_WITH_RUNTIME_PASSWORD
database.validationQuery=SELECT 1 FROM DUAL
