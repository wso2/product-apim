{
  "name": "${UNIQUE:ApiKeyEndpointRouting}",
  "context": "${UNIQUE:apiKeyEndpointRoutingContext}",
  "version": "1.0.0",
  "securityScheme": [
    "api_key",
    "oauth_basic_auth_api_key_mandatory"
  ],
  "endpointConfig": {
    "endpoint_type": "http",
    "production_endpoints": {
      "template_not_supported": false,
      "config": null,
      "url": "http://nodebackend:3001/jaxrs_basic/services/customers/customerservice/echo/prod"
    },
    "sandbox_endpoints": {
      "url": "http://nodebackend:3001/jaxrs_basic/services/customers/customerservice/echo/sandbox",
      "config": null,
      "template_not_supported": false
    }
  },
  "description": "API-key-only endpoint routing probe with distinguishable production and sandbox backends",
  "policies": [
    "Gold",
    "Bronze",
    "Unlimited"
  ],
  "operations": [
    {
      "verb": "GET",
      "target": "/x",
      "authType": "Application & Application User",
      "throttlingPolicy": "Unlimited",
      "scopes": []
    }
  ],
  "isDefaultVersion": true,
  "additionalProperties": [],
  "additionalPropertiesMap": {}
}
