<!--
    Approval-callback compatibility configuration for workflow_ws_api_state_change.feature ONLY.
    Retains APIStateChangeWSWorkflowExecutor and every other executor from workflow-extensions-bpmn.xml,
    but excludes Created:Publish while completing an already-held approval.

    Product defect: WS.complete() marks APPROVED, then calls APIProvider.changeLifeCycleStatus(), which
    re-enters execute(). Keeping Created:Publish selected starts another BPMN process instead of publishing.
    Excluding it lets the existing WS execute() auto-approve that transition on re-entry.

    This temporarily disables Publish workflow gating for the acting tenant. Use only around the approval
    callback in the isolated, serialized runner; immediately reinstall workflow-extensions-bpmn.xml afterward.
    The runner also restores the captured pre-test configuration on failure. This is an approval-only test
    workaround, not evidence that the unmodified external executor works and not a rejection workaround.
    The product must resume the held transition without executing the external workflow again after approval.
-->
<WorkFlowExtensions>
    <APIRevisionDeployment executor="org.wso2.carbon.apimgt.impl.workflow.APIRevisionDeploymentApprovalWorkflowExecutor"/>
    <ApplicationCreation executor="org.wso2.carbon.apimgt.impl.workflow.ApplicationCreationApprovalWorkflowExecutor">
        <Property name="applicationAttributesVisibility">true</Property>
    </ApplicationCreation>
    <ApplicationUpdate executor="org.wso2.carbon.apimgt.impl.workflow.ApplicationUpdateApprovalWorkflowExecutor">
        <Property name="applicationAttributesVisibility">true</Property>
    </ApplicationUpdate>
    <ProductionApplicationRegistration executor="org.wso2.carbon.apimgt.impl.workflow.ApplicationRegistrationApprovalWorkflowExecutor">
        <Property name="applicationAttributesVisibility">true</Property>
    </ProductionApplicationRegistration>
    <SandboxApplicationRegistration executor="org.wso2.carbon.apimgt.impl.workflow.ApplicationRegistrationApprovalWorkflowExecutor">
        <Property name="applicationAttributesVisibility">true</Property>
    </SandboxApplicationRegistration>
    <SubscriptionCreation executor="org.wso2.carbon.apimgt.impl.workflow.SubscriptionCreationApprovalWorkflowExecutor"/>
    <SubscriptionUpdate executor="org.wso2.carbon.apimgt.impl.workflow.SubscriptionUpdateApprovalWorkflowExecutor"/>
    <UserSignUp executor="org.wso2.carbon.apimgt.impl.workflow.UserSignUpApprovalWorkflowExecutor"/>
    <SubscriptionDeletion executor="org.wso2.carbon.apimgt.impl.workflow.SubscriptionDeletionApprovalWorkflowExecutor"/>
    <ApplicationDeletion executor="org.wso2.carbon.apimgt.impl.workflow.ApplicationDeletionApprovalWorkflowExecutor">
        <Property name="applicationAttributesVisibility">true</Property>
    </ApplicationDeletion>

    <!-- Publisher related workflows -->
    <APIStateChange executor="org.wso2.carbon.apimgt.impl.workflow.APIStateChangeWSWorkflowExecutor">
        <Property name="serviceEndpoint">http://nodebackend:3004</Property>
        <Property name="username">admin</Property>
        <Property name="password">admin</Property>
        <Property name="processDefinitionKey">APIStateChangeApprovalProcess</Property>
        <Property name="stateList">Published:Block</Property>
    </APIStateChange>

    <APIProductStateChange executor="org.wso2.carbon.apimgt.impl.workflow.APIProductStateChangeApprovalWorkflowExecutor">
        <Property name="stateList">Created:Publish,Published:Block</Property>
    </APIProductStateChange>

</WorkFlowExtensions>
