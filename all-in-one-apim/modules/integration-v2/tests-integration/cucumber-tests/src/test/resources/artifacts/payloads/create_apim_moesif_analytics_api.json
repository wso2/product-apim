      "verb": "POST",
      "target": "/reflect-body-typed",
      "scopes": []
    },
    {
      "verb": "POST",
      "target": "/reflect-body-sensitive",
      "scopes": []
    },
    {
      "verb": "POST",
      "target": "/reflect-body",
      "scopes": []
    },
    {
      "verb": "GET",
