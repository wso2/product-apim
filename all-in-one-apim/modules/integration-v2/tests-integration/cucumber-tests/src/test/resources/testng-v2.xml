<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<!--
  Concurrency probe: the Publisher and Gateway runners only, split into 12 blocks run four at a time.
  Publisher is two blocks with one runner at a time; Gateway is ten blocks with two runners at a time. The runners are
  balanced across blocks by their sequential CI execution times and the blocks are listed longest first, so TestNG
  starts the longest blocks first. CI caps each APIM container at one CPU (-Dapim.container.cpus=1).
-->
<suite name="Integration Tests v2" parallel="tests" thread-count="4">
    <listeners>
        <listener class-name="org.wso2.am.integration.cucumbertests.utils.listeners.BlockLifecycleListener"/>
        <listener class-name="org.wso2.am.integration.cucumbertests.utils.listeners.BlockScopeListener"/>
        <listener class-name="org.wso2.am.integration.cucumbertests.utils.listeners.CoverageAggregationListener"/>
    </listeners>

    <test name="IntegrationV2-Gateway-1" parallel="classes" thread-count="2">
        <parameter name="blockLabel" value="gateway-1"/>
        <parameter name="initTenantUsers" value="true"/>
        <parameter name="initBackend" value="true"/>
        <classes>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.GatewaySecurityEnforcementRunner"/>
        </classes>
    </test>
    <test name="IntegrationV2-Gateway-2" parallel="classes" thread-count="2">
        <parameter name="blockLabel" value="gateway-2"/>
        <parameter name="initTenantUsers" value="true"/>
        <parameter name="initBackend" value="true"/>
        <classes>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.GatewayRestInvocationRunner"/>
        </classes>
    </test>
    <test name="IntegrationV2-Gateway-3" parallel="classes" thread-count="2">
        <parameter name="blockLabel" value="gateway-3"/>
        <parameter name="initTenantUsers" value="true"/>
        <parameter name="initBackend" value="true"/>
        <classes>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.GatewayMediationPoliciesRunner"/>
        </classes>
    </test>
    <test name="IntegrationV2-Gateway-4" parallel="classes" thread-count="2">
