    <!-- Email as username: its own block, and the only one that may set emailUserMode. The listener automatically
         applies the email-user overlay when emailUserMode is true; no separate tomlExtraOverlayPath is required.
         The mode and its automatically applied overlay must remain together: the overlay configures product
         username resolution, while the mode provisions the matching email-form users. Neither is co-hostable with
         runners that expect the plain actor usernames.
         The runners after the dedicated email ones are MODE FAN-OUT: existing classes re-run under the mode,
         which is how legacy obtained SUPER_TENANT_EMAIL_USER / TENANT_EMAIL_USER coverage. A class is listed
         only where the PHYSICAL username is load-bearing for an assertion it already makes.
         thread-count=2 is measured, not assumed: 13 runners / 100 scenarios pass at both tc=2 and tc=3 with no
         cross-class interference. Not higher — the block is propagation-bound, so tc=3 bought 4% wall-clock
         while pushing gateway deploy waits from 131s to 150s against the 180s RUNTIME_PROPAGATION_TIMEOUT. -->
    <test name="IntegrationV2-EmailUserName" parallel="classes" thread-count="2">
        <parameter name="blockLabel" value="email-username"/>
        <parameter name="apimCpuLimit" value="1"/>
        <parameter name="initTenantUsers" value="true"/>
        <parameter name="emailUserMode" value="true"/>
        <parameter name="tomlExtraOverlayPath" value="src/test/resources/artifacts/configFiles/logging/deployment.toml"/>
        <parameter name="bootstrapThrottleData" value="true"/>
        <parameter name="throttleDataReadinessSeconds" value="180"/>
        <!-- Gateway invocation in this block needs the node backend; without it Basic auth reaches a SUSPENDED
             endpoint (500) and a 200 would be unreachable (CLAUDE.md §11). -->
        <parameter name="initBackend" value="true"/>
        <!-- Deliberately NO initSecondaryUserStore: the SECONDARY.COM store-principal token arcs live in their own
             feature/runner (KeyManagerTokenIssuanceStorePrincipalRunner, KeyManager block only) because they
             CANNOT pass here. Measured: with emailUserMode the carbon.super row passes but
             SECONDARY.COM/subscriberUser1@tenant1.com is refused 401 — EnableEmailUserName splits on the LAST "@"
             only when a name carries TWO or more, so a single-"@" store principal resolves to carbon.super and
             never to tenant1. That is the specified rule this block exists to exercise, not a defect to seed around. -->
        <classes>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.GatewayBasicAuthEmailUserNameRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.DevPortalApplicationEmailUserNameRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.GatewayThrottleEmailUserNameRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.GatewayThrottleResetEmailUserNameRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.GatewayDenyEnforcementEmailUserNameRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.KeyManagerEmailUserNameLoginRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.PublisherApiProductEmailUserNameRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.DevPortalCommentsRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.DevPortalRatingsRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.DevPortalVisibilityRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.DevPortalVisibilityDomainsRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.DevPortalSearchRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.PublisherAccessControlRunner"/>
            <class name="org.wso2.am.integration.cucumbertests.runners.block.KeyManagerTokenIssuanceRunner"/>
        </classes>
    </test>

