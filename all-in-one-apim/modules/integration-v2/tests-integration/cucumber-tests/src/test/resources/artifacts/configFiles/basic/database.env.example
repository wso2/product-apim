# Copy this file to database.env and fill it with values for an isolated test database service.
# The framework creates and drops two block-specific databases. The provisioning account must have CREATE and DROP
# DATABASE privileges. The runtime account needs full access to databases created by the provisioning account.
# Keep database.env out of source control; CI should create it from secrets at job runtime.

database.type=mysql
database.driver=com.mysql.cj.jdbc.Driver

# URL used by the test JVM for CREATE DATABASE, schema loading, and DROP DATABASE.
database.provision.url=jdbc:mysql://127.0.0.1:3307/?allowPublicKeyRetrieval=true&useSSL=false
database.provision.urlTemplate=jdbc:mysql://127.0.0.1:3307/{database}?allowPublicKeyRetrieval=true&useSSL=false
database.provision.username=REPLACE_WITH_PROVISIONING_USER
database.provision.password=REPLACE_WITH_PROVISIONING_PASSWORD

# URL template used by the APIM container. Keep {database}; the framework replaces it with the unique block DB name.
# The host and container endpoints are separate because local Docker host aliases are not always resolvable on the host.
database.jdbc.urlTemplate=jdbc:mysql://host.docker.internal:3307/{database}?allowPublicKeyRetrieval=true&useSSL=false
database.runtime.username=REPLACE_WITH_RUNTIME_USER
database.runtime.password=REPLACE_WITH_RUNTIME_PASSWORD
database.validationQuery=SELECT 1
