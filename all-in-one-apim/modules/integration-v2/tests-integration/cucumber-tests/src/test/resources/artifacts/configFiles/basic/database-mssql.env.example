# Copy this file to a private env file and provide credentials through CI secrets.
# SQL Server requires case-sensitive database collations; the framework creates the block databases with
# Latin1_General_CS_AS. Provisioning credentials need CREATE/DROP DATABASE and database-user/role privileges.
# The runtime login must already exist on the SQL Server; the framework maps it as db_owner in each block DB.

database.type=mssql
database.driver=com.microsoft.sqlserver.jdbc.SQLServerDriver

# The test JVM uses these URLs for provisioning, script execution, and teardown.
database.provision.url=jdbc:sqlserver://127.0.0.1:1433;databaseName=master;encrypt=true;trustServerCertificate=true;SendStringParametersAsUnicode=false
database.provision.urlTemplate=jdbc:sqlserver://127.0.0.1:1433;databaseName={database};encrypt=true;trustServerCertificate=true;SendStringParametersAsUnicode=false
database.provision.username=REPLACE_WITH_PROVISIONING_USER
database.provision.password=REPLACE_WITH_PROVISIONING_PASSWORD

# APIM containers use this endpoint; set a host/port reachable from Docker.
database.jdbc.urlTemplate=jdbc:sqlserver://host.docker.internal:1433;databaseName={database};encrypt=true;trustServerCertificate=true;SendStringParametersAsUnicode=false
database.runtime.username=REPLACE_WITH_RUNTIME_USER
database.runtime.password=REPLACE_WITH_RUNTIME_PASSWORD
database.validationQuery=SELECT 1
