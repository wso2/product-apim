<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  Suite-group selection: SuiteGroupSelectionListener keeps the product suites' blocks of the groups named by
  -Dapim.v2.test.groups. The test class builds in-memory XmlSuites and drives the selection directly; no Docker required.
-->
<suite name="Framework Verification Suite Groups" parallel="false">
    <test name="SuiteGroupSelection">
        <classes>
            <class name="org.wso2.am.integration.cucumbertests.utils.listeners.SuiteGroupSelectionListenerTest"/>
        </classes>
    </test>
</suite>
