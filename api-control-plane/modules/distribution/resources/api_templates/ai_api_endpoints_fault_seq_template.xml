        #####################  Define the macros ######################

        #macro ( print_string_if_exist $field $default)
        #if($field && "$field" !="")
        "$field"
        #else
        "$default"
        #end
        #end

<!-- Runs on a timeout/connection error; wired via the endpoints sequence's onError attribute. -->
<sequence xmlns="http://ws.apache.org/ns/synapse" name="${endpointKey}_EndpointsFaultSeq${deploymentStage}">
    <log level="custom" category="DEBUG">
        <property name="message" value="Fault-path failover sequence invoked"/>
        <property name="errorCode" expression="get-property('ERROR_CODE')"/>
        <property name="retryCount" expression="get-property('default','retryCount')"/>
    </log>
    <class name="org.wso2.carbon.apimgt.gateway.mediators.AIAPIMediator">
        <property name="llmProviderId" expression="get-property('default','llmProviderId')" type="STRING"/>
        <property name="direction" value="FAULT" type="STRING"/>
    </class>
    <log level="custom" category="DEBUG">
        <property name="message" value="Fault-path failover action"/>
        <property name="action" expression="get-property('AI_FAULT_FAILOVER_ACTION')"/>
    </log>
    <filter source="get-property('AI_FAULT_FAILOVER_ACTION')" regex="RETRY">
        <then>
            <!-- Re-enter the loop; a fault clears the resume state. -->
            <sequence key="${endpointKey}_EndpointsSeq${deploymentStage}"/>
        </then>
        <else>
            <!-- No failover policy, or fallbacks exhausted: run the normal fault sequence. -->
            <sequence key=#print_string_if_exist($faultSequence "fault")/>
        </else>
    </filter>
</sequence>
